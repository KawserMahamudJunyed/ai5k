  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "Next.js :3000 talks only to FastAPI :8000 over /api/v1",
        "JWT bearer on every call; Cognito verification when configured, local tokens otherwise"
      ]
    },
    {
      "dot": "emerald",
      "title": "Backend owns data",
      "items": [
        "All reads/writes go through the API \u2014 19 tables in PostgreSQL",
        "CV bytes land in var/cv_uploads; text is extracted server-side",
        "ai-backend is invoked as a tool, never as a bypass around the API"
      ]
    },
    {
      "dot": "rose",
      "title": "Honest failure",
      "items": [
        "Readiness sources report ok / failed / skipped with machine error codes",
        "Verification is decision-once; approval flips claim and evidence tiers",
        "Score held at 30 until a claim is admin-evidenced"
      ]
    }
  ]
