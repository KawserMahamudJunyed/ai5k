# Local dev environment (generated by Freebuff — never commit)
ENV=local
SECRET_KEY=change-me-in-prod
LOCAL_TOKEN_ISSUER=ai5k-local
LOCAL_TOKEN_AUDIENCE=ai5k-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TTL_SECONDS=86400

# Local system PostgreSQL 18 (peer auth via Unix socket as user xenon)
DATABASE_URL=postgresql+asyncpg://xenon@/ai5k?host=/var/run/postgresql

# AWS Cognito (disabled for local dev)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1
COGNITO_JWKS_CACHE_TTL_SECONDS=3600
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Other services (unused locally)
S3_EVIDENCE_BUCKET=
OPENSEARCH_ENDPOINT=
LLM_PROVIDER_BASE_URL=
