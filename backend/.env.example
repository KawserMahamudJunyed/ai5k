# Copy to .env and fill in real values. Never commit .env.

# --- App ---
ENV=local
SECRET_KEY=change-me-in-prod
# Issuer/audience for locally-issued tokens (local fallback auth path; see docs/auth.md)
LOCAL_TOKEN_ISSUER=ai5k-local
LOCAL_TOKEN_AUDIENCE=ai5k-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TTL_SECONDS=86400

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai5k

# --- AWS Cognito (Task 1.3) ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1
COGNITO_JWKS_CACHE_TTL_SECONDS=3600
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Other services (used by later tasks) ---
S3_EVIDENCE_BUCKET=
OPENSEARCH_ENDPOINT=
LLM_PROVIDER_BASE_URL=
